# Copy this to .env and fill in your actual values
# cp .env.example .env

# Postgres config (these also get used by the db container in docker-compose)
POSTGRES_DB=frammer_analytics
POSTGRES_USER=frammer
POSTGRES_PASSWORD=frammer_secret

# SQLAlchemy connection string — note "db" is the docker service name,
# swap to "localhost" if you're running outside docker
DATABASE_URL=postgresql://frammer:frammer_secret@db:5432/frammer_analytics

# JWT stuff
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Gemini API key for the ATLAS agent (grab one from https://aistudio.google.com/apikey)
# not needed until phase 7, so don't stress about this yet
GEMINI_API_KEY=your-google-ai-studio-api-key

# Vite needs to know where the API is
VITE_API_URL=http://localhost:8000
